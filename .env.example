# ─────────────────────────────────────────────────────────────
# ClothStore AI - environment variables
#
# Copy this file to `.env` in the same folder as main.py, then fill in
# your own values:
#     Windows (PowerShell):  Copy-Item .env.example .env
#     Mac / Linux:           cp .env.example .env
#
# Never commit your real `.env` file - it is already in .gitignore.
# ─────────────────────────────────────────────────────────────


# ── MongoDB (required) ───────────────────────────────────────
# Connection string for your MongoDB database. The app uses the
# `ecommerce_db` database and creates the collections automatically.
#
# MongoDB Atlas (free cloud cluster: https://www.mongodb.com/atlas):
#     MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
# Local MongoDB install:
#     MONGO_URI=mongodb://localhost:27017
MONGO_URI=


# ── Groq (required) ──────────────────────────────────────────
# API key for the AI shopping assistant (runs on Groq).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: which Groq model the assistant uses (default: openai/gpt-oss-120b).
# Groq retires models over time - if the chat says "Sorry, I ran into an issue",
# pick a current model from https://console.groq.com/docs/models that supports tool use.
# GROQ_MODEL=openai/gpt-oss-120b


# ── Pydantic Logfire (optional) ──────────────────────────────
# Write token for observability / tracing. If it is not set, the app
# runs normally and just doesn't send logs to Logfire.
# Get one at https://logfire.pydantic.dev  →  Project settings → Write tokens
# Uncomment the line below and add your token to enable it.
# LOGFIRE_TOKEN=
